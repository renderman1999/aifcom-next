# Sviluppo (Vite): server dove risponde Apache con WordPress in /cms (no slash finale).
# Esempio: http://127.0.0.1 se provi dal VPS; oppure https://ip-o-host-del-vps
VITE_WP_PROXY_TARGET=http://127.0.0.1

# Opzionale: build produzione con URL diretto al CMS (salta /api/wp). Su Vercel puoi omettere
# se usi la Edge Function + CMS_WP_JSON_BASE_URL.
# VITE_WP_API_URL=https://host-del-vps/cms/wp-json

# Opzionale
# VITE_WP_API_VERSION=v2
# VITE_WP_URL=https://aifcom.org
